# ---------------------------------------------------------------
# Pürüz Atölye — ortam ayarları / environment settings
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------

APP_NAME="Pürüz Atölye"
APP_ENV=production
# Generate with: php artisan key:generate --show   (or via docker, see docs/DEPLOY-VPS.md)
APP_KEY=
APP_DEBUG=false
APP_URL=https://puruzatolye.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

# Domain(s) Caddy should serve and get HTTPS certificates for (Docker setup only).
SERVER_NAME="puruzatolye.com, www.puruzatolye.com"

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database (MariaDB in docker-compose; DB_HOST is set to "mariadb" there automatically).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=puruz
DB_USERNAME=puruz
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local

# Outgoing email (order confirmations, tracking links). Any SMTP provider works,
# e.g. the domain's mailbox, Brevo, Amazon SES, Yandex 360.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="siparis@puruzatolye.com"
MAIL_FROM_NAME="${APP_NAME}"

# iyzico — use the sandbox URL and sandbox keys until the merchant account is approved.
# Live: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# "fake" replaces iyzico with a local test page. Development only, never in production.
PAYMENT_GATEWAY=iyzico

# First admin account, created by "php artisan db:seed --force".
ADMIN_NAME="Pürüz Yönetici"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma separated proxy IPs if the site sits behind Cloudflare or another proxy.
TRUSTED_PROXIES=127.0.0.1

BACKUP_KEEP_DAYS=14

VITE_APP_NAME="${APP_NAME}"
